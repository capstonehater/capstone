# Copy to deploy/.env; never commit the real file.
NODE_ENV=production
FORECAST_TRAINING_SOURCE=mixed
FORECAST_PORTFOLIO=auto
FORECAST_TRAINING_DAYS=0
# Per-replica bounded read cache; see ims-backend/CACHING.md for freshness limits.
READ_CACHE_ENABLED=true
READ_CACHE_MAX_ENTRIES=1000
READ_CACHE_MAX_BYTES=16777216
READ_CACHE_MAX_ENTRY_BYTES=524288
# Connect to your existing PostgreSQL server; URL-encode special characters.
# Set a small per-process pool so replicas do not exhaust database connections.
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/DATABASE?schema=public&connection_limit=5&pool_timeout=10
SESSION_TOKEN_SECRET=replace-with-a-long-random-secret-shared-by-all-api-replicas
RESET_TOKEN_SECRET=replace-with-a-different-long-random-secret
FRONTEND_ORIGIN=https://cafe.example.com
FRONTEND_APP_URL=https://cafe.example.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
RELEASE_TAG=local
HTTP_PORT=8080
# Default is private to a host TLS reverse proxy. For local HTTP testing only,
# use localhost origins and AUTH_COOKIE_SECURE=false.
LISTEN_ADDRESS=127.0.0.1
NETWORK_SUBNET=172.30.90.0/24
# Optional SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_FROM_EMAIL.
