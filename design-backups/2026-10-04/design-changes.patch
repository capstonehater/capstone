+.details p > span { color:#232d46; font-weight:600; }
+.actions { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:12px; padding:18px 24px; border-top:1px solid #dce2eb; background:white; flex-shrink:0; }
+.actions button { min-height:48px; padding:10px 18px; font-size:16px; font-weight:600; border-radius:10px; }
+.actions button:focus-visible { outline:2px solid #426da6; outline-offset:3px; }
